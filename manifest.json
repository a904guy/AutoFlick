{
  "manifest_version": 3,
  "name": "AutoFlick",
  "version": "1.0.0",
  "description": "Automatically flicks to the next video on YouTube Shorts, TikTok, and Instagram Reels when the current one ends.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AutoFlick",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/common.js", "content/shorts.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content/common.js", "content/tiktok.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content/common.js", "content/instagram.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "autoflick@hawkins.app",
      "strict_min_version": "115.0"
    }
  }
}
